{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memos2txt response",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": { "type": "boolean" },
    "cache_hit": { "type": "boolean" },
    "provider": { "type": "string" },
    "category": { "type": "string", "enum": ["cloud", "local"] },
    "model": { "type": "string" },
    "mode": { "type": "string", "enum": ["transcribe", "setup", "auth", "diarizer_setup"] },
    "options": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "diarization": { "type": "boolean" },
        "punctuate": { "type": "boolean" },
        "diarizer": { "type": "string" },
        "diarizer_model": { "type": "string" },
        "timestamps": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "file_path": { "type": "string" },
        "file_size_bytes": { "type": "integer" },
        "mtime_unix": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "transcript_path": { "type": "string" },
        "inline_mode": { "type": "string", "enum": ["full", "preview"] },
        "transcript_full": { "type": "string" },
        "transcript_preview": { "type": "array", "items": { "type": "string" } },
        "chars": { "type": "integer" },
        "lines": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "preprocess": {
      "type": "object",
      "required": ["triggered"],
      "properties": {
        "triggered": { "type": "boolean" },
        "reason": { "type": "string", "enum": ["threshold", "provider_413", "local_diarization", "local_normalize"] },
        "mode": { "type": "string", "enum": ["normalized", "chunked"] },
        "threshold_mb": { "type": "integer" },
        "temp_kept": { "type": "boolean" },
        "normalized_path": { "type": "string" },
        "normalized_size_bytes": { "type": "integer" },
        "normalize_seconds": { "type": "number" },
        "normalized_transcribe_seconds": { "type": "number" },
        "chunk_seconds": { "type": "integer" },
        "segment_seconds": { "type": "number" },
        "chunk_count": { "type": "integer" },
        "chunk_paths": { "type": "array", "items": { "type": "string" } },
        "chunk_transcribe_seconds": { "type": "array", "items": { "type": "number" } },
        "total_seconds": { "type": "number" }
      },
      "additionalProperties": false
    },
    "diarization": {
      "type": "object",
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" },
        "diarizer": { "type": "string" },
        "model": { "type": "string" },
        "device": { "type": "string" },
        "speaker_count": { "type": "integer" },
        "speakers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "label", "turns", "speech_seconds"],
            "properties": {
              "id": { "type": "string" },
              "label": { "type": "string" },
              "turns": { "type": "integer" },
              "speech_seconds": { "type": "number" }
            },
            "additionalProperties": false
          }
        },
        "seconds": { "type": "number" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "local_env": {
      "type": "object",
      "required": ["installed", "hf_configured"],
      "properties": {
        "kind": { "type": "string" },
        "installed": { "type": "boolean" },
        "venv_path": { "type": "string" },
        "python": { "type": "string" },
        "python_version": { "type": "string" },
        "pyannote_version": { "type": "string" },
        "model": { "type": "string" },
        "device": { "type": "string" },
        "hf_configured": { "type": "boolean" },
        "note": { "type": "string" }
      },
      "additionalProperties": false
    },
    "note": { "type": "string" },
    "setup": {
      "type": "object",
      "properties": {
        "store": { "type": "string", "enum": ["keychain", "file"] },
        "env_var": { "type": "string" },
        "status": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "FILE_NOT_FOUND",
            "FILE_UNREADABLE",
            "API_KEY_MISSING",
            "UPLOAD_FAILED",
            "TIMEOUT",
            "PROVIDER_ERROR",
            "TRANSCRIPT_WRITE_FAILED",
            "INVALID_ARGS",
            "LOCAL_DEPENDENCY_MISSING",
            "DIARIZATION_FAILED"
          ]
        },
        "message": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "version": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] }
    }
  ]
}
