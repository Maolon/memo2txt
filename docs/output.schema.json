{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "memos2txt response",
  "type": "object",
  "required": ["ok"],
  "properties": {
    "ok": { "type": "boolean" },
    "cache_hit": { "type": "boolean" },
    "provider": { "type": "string" },
    "model": { "type": "string" },
    "mode": { "type": "string", "enum": ["transcribe", "setup"] },
    "options": {
      "type": "object",
      "properties": {
        "language": { "type": "string" },
        "diarization": { "type": "boolean" },
        "punctuate": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "file_path": { "type": "string" },
        "file_size_bytes": { "type": "integer" },
        "mtime_unix": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "output": {
      "type": "object",
      "properties": {
        "transcript_path": { "type": "string" },
        "inline_mode": { "type": "string", "enum": ["full", "preview"] },
        "transcript_full": { "type": "string" },
        "transcript_preview": { "type": "array", "items": { "type": "string" } },
        "chars": { "type": "integer" },
        "lines": { "type": "integer" }
      },
      "additionalProperties": false
    },
    "preprocess": {
      "type": "object",
      "required": ["triggered"],
      "properties": {
        "triggered": { "type": "boolean" },
        "reason": { "type": "string", "enum": ["threshold", "provider_413"] },
        "mode": { "type": "string", "enum": ["normalized", "chunked"] },
        "threshold_mb": { "type": "integer" },
        "temp_kept": { "type": "boolean" },
        "normalized_path": { "type": "string" },
        "normalized_size_bytes": { "type": "integer" },
        "normalize_seconds": { "type": "number" },
        "normalized_transcribe_seconds": { "type": "number" },
        "chunk_seconds": { "type": "integer" },
        "segment_seconds": { "type": "number" },
        "chunk_count": { "type": "integer" },
        "chunk_paths": { "type": "array", "items": { "type": "string" } },
        "chunk_transcribe_seconds": { "type": "array", "items": { "type": "number" } },
        "total_seconds": { "type": "number" }
      },
      "additionalProperties": false
    },
    "note": { "type": "string" },
    "setup": {
      "type": "object",
      "properties": {
        "store": { "type": "string", "enum": ["keychain", "file"] },
        "env_var": { "type": "string" }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "FILE_NOT_FOUND",
            "FILE_UNREADABLE",
            "API_KEY_MISSING",
            "UPLOAD_FAILED",
            "TIMEOUT",
            "PROVIDER_ERROR",
            "TRANSCRIPT_WRITE_FAILED",
            "INVALID_ARGS"
          ]
        },
        "message": { "type": "string" },
        "detail": { "type": "string" }
      },
      "additionalProperties": false
    },
    "version": { "type": "string" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "ok": { "const": true } } },
      "then": { "not": { "required": ["error"] } }
    },
    {
      "if": { "properties": { "ok": { "const": false } } },
      "then": { "required": ["error"] }
    }
  ]
}
